{
  "manifest_version": 3,
  "name": "sessfork — Local Session Bridge",
  "version": "0.2.1",
  "description": "One-click local sync of logged-in Cookies & LocalStorage to sessfork-mcp so headless AI agents browse without focus theft.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "sessfork — Fork This Site",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
