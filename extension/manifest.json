{
  "manifest_version": 3,
  "name": "sessfork — Local Session Bridge",
  "version": "0.2.1",
  "description": "User-consented 1-click Cookie & LocalStorage sync from Chrome/Edge to local sessfork-mcp (zero cloud, zero injection, native Windows Chrome v20 ABE support).",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "sessfork — Fork This Site",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
